# File: nginx/templates/ip-validation.conf.template
# Version: v1.0.0 (Genesis)
# Description: 客户端真实IP交叉验证逻辑模板.
#
# --- Generated by 20-generate-ip-logic.sh ---

# 步骤 1: 动态生成的 CDN 头聚合逻辑
# 将按优先顺序从 CDN headers (e.g., CF-Connecting-IP) 中提取第一个非空 IP 到 $cdn_client_ip
<% DYNAMIC_CDN_IP_MAP_CHAIN %>

# 步骤 1.5: 动态生成的 CDN 提供商识别逻辑
# 将根据哪个 CDN header 存在，将提供商别名 (e.g., "cf") 存入 $cdn_provider
<% DYNAMIC_CDN_PROVIDER_LOGIC %>

# 步骤 2: 从 X-Forwarded-For 中提取最左侧的 IP
# 例如, "1.1.1.1, 2.2.2.2" -> "1.1.1.1"
map $http_x_forwarded_for $xff_first_ip {
    ~^([^,]+) $1;
    default "";
}

# 步骤 3: 交叉验证 IP
# 策略:
# 1. 如果 $cdn_client_ip 存在, 我们就信任 CDN 提供的 IP。
# 2. 如果 $cdn_client_ip 不存在 (即没有 CDN), 我们回退到使用 $xff_first_ip (来自常规代理)。
# 注意: $validated_ip 是最终暴露给日志和应用的真实客户端 IP。
map "$cdn_client_ip" $validated_ip {
    # Case 1: CDN IP 存在, 信任CDN (正则~.匹配任何非空字符串)
    ~. $cdn_client_ip;
    # Case 2: CDN IP 不存在, 回退到 XFF 的第一个 IP
    default $xff_first_ip;
}

# 步骤 4: 最终回退逻辑
# 确保我们总能得到一个IP地址
map "$validated_ip" $real_client_ip {
    # 如果交叉验证成功，使用验证后的 IP
    ~. $validated_ip;
    # Fallback 1: 如果没有 CDN 和 XFF, 使用 Fly.io 提供的 header (如果存在)
    default $http_fly_client_ip;
}

# 最终安全保障: 如果 $real_client_ip 仍然为空, 就使用原始的 $remote_addr
map "$real_client_ip" $final_real_client_ip {
    default $real_client_ip;
    ""      $remote_addr;
}
