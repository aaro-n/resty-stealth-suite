ssl_certificate /etc/nginx/certs/cert.pem;
ssl_certificate_key /etc/nginx/certs/key.pem;

# 仅启用 TLS 1.2 和 1.3，禁用不安全的 SSLv3/TLSv1.0/TLSv1.1
ssl_protocols TLSv1.2 TLSv1.3;
# 使用现代安全的加密套件，禁用弱加密算法
ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
# 优先使用服务器端定义的加密套件顺序
ssl_prefer_server_ciphers on;

# 🚀 [极致建连延迟优化：TLS 会话复用 (TLS Session Resumption)]
# 大幅缩减二次访问时的握手开销（由 1.5 握手 RTT 直接降为 0-1 RTT）
ssl_session_cache shared:SSL:10m;  # 分配 10MB 物理共享内存作为 SSL 会话缓存区
ssl_session_timeout 1d;            # 会话缓存超时时间 1 天
ssl_session_tickets on;            # 启用 Session Tickets，双重会话恢复保障

