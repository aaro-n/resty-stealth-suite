# File: .env.example
# 用途: 本地开发和测试时使用的环境变量示例。所有系统环境变量现已全量对齐至具有 RG_ 统一前缀的新版格式。

# --- 443 Stream 模块配置 ---
RG_AUTH_DOMAIN=auth.test.local,auth2.test.local
RG_STREAM_UPSTREAM_MAP=test.local:httpbin.org:443,*:google.com:443
RG_NGINX_DNS_RESOLUTION_SECONDS=600

# --- 8443 Auth 模块配置 ---
RG_SECRET_TOKEN=my-super-secret-token
RG_AUTH_PATH_PREFIX=auth
RG_WHITELIST_IP_TTL_SECONDS=300
RG_NGINX_TLS_MODE=https
RG_NGINX_USERS=admin:password

# 8443 端口域名访问控制
# 'true': 允许任何域名访问 8443 端口。
# 'false' (默认): 只允许 RG_AUTH_DOMAIN 中定义的域名访问 8443 端口。
RG_AUTH_ALLOW_ANY_DOMAIN=false
